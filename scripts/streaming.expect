# demo-cols: 120
# demo-rows: 24

set timeout 20

proc send_arrow {direction selection} {
    send "\033\[$direction"
    expect -re [format {> [^\r\n]*%s} $selection]
    sleep 0.3
}

proc type_and_expect {text} {
    set value ""
    foreach char [split $text ""] {
        send -- $char
        append value $char
        expect $value
    }
}

set bin $env(GRPCEXP_DEMO_BIN)
set target $env(GRPCEXP_DEMO_TARGET)

spawn -noecho env -u NO_COLOR TERM=xterm-256color COLORTERM=truecolor $bin -a $target
expect "more"

sleep 1.0
send_arrow B echo.v1.EchoService
send_arrow B grpc.reflection.v1.ServerReflection
send_arrow B grpc.reflection.v1alpha.ServerReflection
send_arrow B hello.v1.HelloService
send "\r"
expect "hello.v1.HelloService.HelloStream"

sleep 0.9
send "\r"
expect "No stream events yet."

type_and_expect "Pranav"

sleep 0.8
send_arrow B Send
sleep 0.8
send "\r"
expect "Hello Pranav"

sleep 0.8
send_arrow A {name:}
send "\x15"

type_and_expect "Manya"

sleep 0.8
send_arrow B Send
sleep 0.8
send "\r"
expect "Hello Manya"

sleep 3.0
