set timeout 10
expect_after {
    timeout {
        puts stderr "demo failed: timed out waiting for terminal output"
        exit 1
    }
    eof {
        puts stderr "demo failed: grpcexp exited unexpectedly"
        exit 1
    }
}

proc send_arrow {direction selection} {
    send "\033\[$direction"
    expect -re [format {> [^\r\n]*%s} $selection]
    sleep 0.3
}

set bin $env(GRPCEXP_DEMO_BIN)
set target $env(GRPCEXP_DEMO_TARGET)

spawn -noecho env -u NO_COLOR TERM=xterm-256color COLORTERM=truecolor $bin -a $target
expect "more"

sleep 1.0
send_arrow B echo.v1.EchoService
send_arrow B grpc.reflection.v1.ServerReflection
send_arrow B grpc.reflection.v1alpha.ServerReflection
send_arrow B hello.v1.HelloService
send_arrow B helloworld.Greeter
send "\r"
expect "helloworld.Greeter.SayHello"

sleep 0.9
send "\r"
expect "copy grpcurl"

# The renderer outputs changed characters, not the full input value.
foreach char [split "Pranav" ""] {
    send -- $char
    sleep 0.1
}

sleep 0.8
send_arrow B Submit

sleep 0.8
send "\r"
expect "Hello Pranav"

sleep 3.0

# End the interactive app so the recording can finish cleanly.
send "\x03"
expect {
    eof {}
}
wait
